<Page
    x:Class="XAU.Views.Pages.MiscPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XAU.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="MiscPagen"
    Title="Misc Page"
    d:DataContext="{d:DesignInstance local:MiscPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Width="{Binding ElementName=MiscPagen, Path=ActualWidth}" Height="{Binding ElementName=MiscPagen, Path=ActualHeight}">
        <TabControl x:Name="MiscTabControl" Margin="0,0,0,0" SelectedIndex="{Binding ViewModel.SelectedTabIndex, Mode=TwoWay}">
            <TabItem IsSelected="True" Width="150">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="XboxController24" />
                        <TextBlock Text="Spoofer" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0" Text="{Binding ViewModel.SpoofingText}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ViewModel.SpooferButtonClickedCommand}"
                        Content="{Binding ViewModel.SpoofingButtonText, IsAsync=true}"
                        IsEnabled="{Binding ViewModel.IsInitialized}" />
                    <ui:TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        VerticalAlignment="Top"
                        PlaceholderText="Title ID"
                        Text="{Binding ViewModel.NewSpoofingID, Mode=TwoWay}" />
                    <ui:Image
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="250"
                        Height="250"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Source="{Binding ViewModel.GameImage}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="260,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="{Binding ViewModel.GameName}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="260,20,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="{Binding ViewModel.GameTitleID}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="260,40,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="{Binding ViewModel.GamePFN}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="260,60,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="{Binding ViewModel.GameType}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="260,80,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="{Binding ViewModel.GameGamepass}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="260,100,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="{Binding ViewModel.GameDevices}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="260,120,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="{Binding ViewModel.GameGamerscore}" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="260,140,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="{Binding ViewModel.GameTime}" />

                </Grid>
            </TabItem>

            <TabItem Width="150">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="Search24" />
                        <TextBlock Text="Title ID Search" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Margin="0,0,0,15"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid Margin="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:TextBox
                                x:Name="TitleIdSearchBox"
                                Grid.Column="0"
                                Margin="0,0,15,0"
                                FontSize="14"
                                KeyDown="TitleIDSearch_OnKeyDown"
                                PlaceholderText="Type game name to search..."
                                Text="{Binding ViewModel.TSearchText, Mode=TwoWay}" />

                            <ui:Button
                                Grid.Column="1"
                                MinWidth="100"
                                Command="{Binding ViewModel.SearchGameCommand}"
                                Content="Search"
                                Icon="{ui:SymbolIcon Search24}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,15,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="15,15,15,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Search Results" />

                                <ListBox
                                    Grid.Row="1"
                                    Margin="10,0,10,15"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding ViewModel.TSearchTitleNames}"
                                    SelectionChanged="Selector_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="8,5,8,5"
                                                FontSize="13"
                                                Text="{Binding}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,20"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="Game Details" />

                                <StackPanel Grid.Row="1">
                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Game Name" />
                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding ViewModel.TSearchGameName}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Title ID" />
                                        <ui:TextBox
                                            MaxWidth="200"
                                            Margin="0,5,0,0"
                                            HorizontalAlignment="Left"
                                            IsReadOnly="True"
                                            Text="{Binding ViewModel.TSearchGameTitleID, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,20">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Title Based" />
                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding ViewModel.TSearchGameTitleBased}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Width="150">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="Search24" />
                        <TextBlock Text="Gamertag Search" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="25,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Command="{Binding ViewModel.SearchGamertagCommand}"
                        Icon="{ui:SymbolIcon Search24}"
                        IsEnabled="{Binding ViewModel.IsInitialized}" />
                    <ui:TextBox
                        x:Name="GamertagSearchBox"
                        Grid.Row="0"
                        Grid.Column="0"
                        MinWidth="200"
                        Margin="0,0,40,0"
                        VerticalAlignment="Top"
                        ClearButtonEnabled="False"
                        KeyDown="GamertagSearch_OnKeyDown"
                        PlaceholderText="Gamertag"
                        Text="{Binding ViewModel.Gamertag, Mode=TwoWay}" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <Image
                            Width="100"
                            Height="100"
                            Margin="5,0,10,0"
                            Source="{Binding ViewModel.GamertagImage}" />
                        <StackPanel>
                            <Label Margin="0,0,0,5" Content="{Binding ViewModel.GamertagName}" />
                            <Label Margin="0,0,0,5" Content="{Binding ViewModel.GamertagScore}" />
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Text="XUID: " />
                            <TextBox
                                Margin="0,0,0,5"
                                IsReadOnly="True"
                                Text="{Binding ViewModel.GamertagXuid, Mode=OneWay}" />
                            <ui:ToggleSwitch
                                x:Name="ExcludeZeroGamerscoreToggle"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,10,0,10"
                                Content="Exclude 0 Gamerscore Games"
                                IsChecked="{Binding ViewModel.ExcludeZeroGamerscoreGames, Mode=TwoWay}" />
                            <ui:ToggleSwitch
                                x:Name="ExcludeXbox360GamesToggle"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,5,0,10"
                                Content="Exclude Xbox 360 Games"
                                IsChecked="{Binding ViewModel.ExcludeXbox360Games, Mode=TwoWay}" />
                            <ui:Button
                                x:Name="ExportButton"
                                Click="ExportToCsvButton_Click"
                                Content="Export Games to CSV"
                                Icon="{ui:SymbolIcon Save24}"
                                IsEnabled="{Binding ViewModel.IsInitialized}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Width="150">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="Search24" />
                        <TextBlock Text="Xbox Status" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,15"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Xbox Live service health (run on-demand)" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <ui:Button
                            MinWidth="200"
                            Margin="0,0,15,0"
                            Command="{Binding ViewModel.CheckXboxServiceHealthCommand}"
                            Content="Check Xbox Service Health"
                            Icon="{ui:SymbolIcon Search24}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding ViewModel.XboxServiceStatus, Mode=OneWay}" />
                    </StackPanel>
                    <ListBox
                        Grid.Row="2"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding ViewModel.XboxServiceStatusLines, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,2,0,2"
                                    FontSize="13"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Width="150">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="Search24" />
                        <TextBlock Text="Auto Unlock" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ListBox
                        Grid.Row="2"
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding ViewModel.XboxServiceStatusLines, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,2,0,2"
                                    FontSize="13"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock HorizontalAlignment="Left" Margin="6,2,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Settings :" VerticalAlignment="Top" Width="82" FontSize="16"/>
                    <ComboBox x:Name="AutoUnlock_ComboBoxOrder" Width="123" Height="36" FontSize="12" Margin="78,23,0,0" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left" SelectionChanged="AutoUnlock_ComboBoxOrder_SelectionChanged">
                        <ComboBoxItem Content="Descending" IsSelected="True" FontSize="11"/>
                        <ComboBoxItem Content="Ascending"/>
                    </ComboBox>
                    <TextBlock HorizontalAlignment="Left" Margin="8,31,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Order rarity:" VerticalAlignment="Top" Width="74" FontSize="12"/>
                    <CheckBox x:Name="AutoUnlock_EnableCheckBox" Content="Enable" Margin="200,3,0,0" Grid.Row="2" VerticalAlignment="Top" Width="98" Height="25" HorizontalAlignment="Center" Checked="AutoUnlock_EnableCheckBox_Checked" Unchecked="AutoUnlock_EnableCheckBox_Checked"/>
                    <TextBlock HorizontalAlignment="Center" Margin="70,3,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Statut :" VerticalAlignment="Top" Width="55" FontSize="16"/>
                    <Border BorderBrush="Black" BorderThickness="1" Grid.Row="2" Background="Black" Width="5" Height="93" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Border BorderBrush="Black" Grid.Row="2" Background="Black" Width="1085" Height="5" VerticalAlignment="Top" Margin="0,88,0,0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AutoUnlock_TextStatut" HorizontalAlignment="Center" Margin="240,25,0,0" Grid.Row="2" TextWrapping="Wrap" Text="OFF" VerticalAlignment="Top" Width="230" FontSize="16" Foreground="Red"/>
                    <TextBlock x:Name="AutoUnlock_NameGameSelect" HorizontalAlignment="Center" Margin="400,67,0,0" Grid.Row="2" TextWrapping="Wrap" Text="No Game Selected" VerticalAlignment="Top" Width="387" FontSize="16"/>
                    <TextBlock x:Name="AutoUnlock_TextRemain" HorizontalAlignment="Center" Margin="400,45,0,0" Grid.Row="2" TextWrapping="Wrap" Text="0 Remains / 0 min to finish" VerticalAlignment="Top" Width="387" FontSize="16"/>
                    <ComboBox x:Name="AutoUnlock_ComboBoxTime" Width="123" Height="36" FontSize="12" Margin="275,23,0,0" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left" SelectionChanged="AutoUnlock_ComboBoxTime_SelectionChanged">
                        <ComboBoxItem Content="5-10 Min" IsSelected="True" FontSize="11"/>
                        <ComboBoxItem Content="10-20 Min"/>
                        <ComboBoxItem Content="20-40 Min"/>
                    </ComboBox>
                    <TextBlock HorizontalAlignment="Left" Margin="201,31,0,0" Grid.Row="2" TextWrapping="Wrap" Text="Time interval:" VerticalAlignment="Top" Width="74" FontSize="12"/>
                    <ProgressBar x:Name="AutoUnlock_ProgressBar" Height="21" Margin="0,93,0,0" Grid.Row="2" VerticalAlignment="Top" Width="800"/>
                    <ListBox x:Name="AutoUnlock_ListAchivement" Margin="0,114,0,0" Grid.Row="2" Grid.RowSpan="3" Focusable="False" SelectionChanged="AutoUnlock_ListAchivement_SelectionChanged">
                        <ListBoxItem Content="List unlock order :"/>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Page>
