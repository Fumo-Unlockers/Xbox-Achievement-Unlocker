<Page x:Class="XAU.Views.Pages.AchievementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:p="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:XAU.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AchievementsPage"
      x:Name="AchievementsPagen"
      d:DataContext="{d:DesignInstance local:AchievementsPage,
                                 IsDesignTimeCreatable=False}"
      d:DesignHeight="450"
      d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid
          Height="{Binding ElementName=AchievementsPagen, Path=ActualHeight}"
          Width="{Binding ElementName=AchievementsPagen, Path=ActualWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Grid.Row="1"
                Grid.Column="0"
                x:Name="TitleIDBox"
                IsEnabled="{Binding ViewModel.TitleIDEnabled}"
                Padding="10,4,8,7"
                Margin="0,0,44,0"
                Text="{Binding ViewModel.TitleIDOverride, Mode=TwoWay}"
                TextAlignment="Center"
                ClearButtonEnabled="False" 
            ></ui:TextBox>
            <ui:Button
                Grid.Row="1"
                Grid.Column="0"
                x:Name="TitleIDRefreshButton"
                IsEnabled="{Binding ViewModel.TitleIDEnabled}"
                Padding="10,5,8,5"
                Margin="10,0,5,0"
                Content=""
                HorizontalAlignment="Right"
                Icon="{ui:SymbolIcon ArrowRepeatAll24}"
                Command="{Binding ViewModel.RefreshAchievementsCommand}"/>
            <Label 
                Grid.Row="0" 
                Grid.Column="0"
                Margin="0,0,54,0"
                Content="TitleID Override"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>


            <ui:TextBox
                Grid.Row="1"
                Grid.Column="1"
                x:Name="SearchBox"
                IsEnabled="{Binding ViewModel.TitleIDEnabled}"
                Padding="10,4,8,7"
                Margin="0,0,44,0"
                Text="{Binding ViewModel.SearchText, Mode=TwoWay, IsAsync=true}"
                TextAlignment="Center"
                ClearButtonEnabled="False" 
                KeyDown="SearchBox_OnKeyDownAsync"
            ></ui:TextBox>
            <ui:Button
                Grid.Row="1"
                Grid.Column="1"
                x:Name="SearchButton"
                IsEnabled="{Binding ViewModel.TitleIDEnabled}"
                Padding="10,5,8,5"
                Margin="10,0,5,0"
                Content=""
                HorizontalAlignment="Right"
                Icon="{ui:SymbolIcon Search24}"
                Command="{Binding ViewModel.SearchAndFilterAchievementsCommand}"/>
            <Label 
                Grid.Row="0" 
                Grid.Column="1"
                Margin="00,0,44,0"
                Content="Search"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>

            <StackPanel
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                Margin="10,0,10,0"
                Visibility="{Binding ViewModel.IsEventUnlockAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:ToggleSwitch
                    Margin="0,0,0,4"
                    Content="Custom Event Time"
                    IsChecked="{Binding ViewModel.UseCustomEventUnlockTime, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal">
                    <DatePicker
                        Width="125"
                        Margin="0,0,6,0"
                        IsEnabled="{Binding ViewModel.UseCustomEventUnlockTime}"
                        SelectedDate="{Binding ViewModel.CustomEventUnlockDate, Mode=TwoWay}"/>
                    <ui:TextBox
                        Width="80"
                        ClearButtonEnabled="False"
                        IsEnabled="{Binding ViewModel.UseCustomEventUnlockTime}"
                        PlaceholderText="HH:mm:ss"
                        Text="{Binding ViewModel.CustomEventUnlockTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Label 
                Grid.Row="0" 
                Grid.Column="3"
                Margin="10,0,10,0"
                Content="{Binding ViewModel.GameInfo}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
            <TextBlock
                Grid.Row="1"
                Grid.Column="3"
                Margin="10,0,10,0"
                Text="{Binding ViewModel.GameName}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                TextAlignment="Center"
                />
            <ui:Button
                Grid.Row="0"
                Grid.Column="4"
                x:Name="UnlockAllButton"
                IsEnabled="{Binding ViewModel.IsUnlockAllEnabled}"
                Padding="10,5,8,5"
                Margin="10,0,5,2"
                Content="Unlock All"
                HorizontalAlignment="Right"
                Command="{Binding ViewModel.UnlockAllCommand}"
            />
            <ui:Button
                Grid.Row="1"
                Grid.Column="4"
                x:Name="RefreshButton"
                Padding="10,5,8,5"
                Margin="10,2,5,0"
                Content="Refresh"
                HorizontalAlignment="Stretch"
                Command="{Binding ViewModel.RefreshAchievementsCommand}"
            />
        </Grid>
        <DataGrid Grid.Row="1"  
                  VerticalScrollBarVisibility="Visible" 
                  HorizontalScrollBarVisibility="Visible"
                  Margin="0,5,0,5" 
                  AutoGenerateColumns="False"  
                  ItemsSource="{Binding ViewModel.DGAchievements}" 
                  SelectedItem="{Binding ViewModel.SelectedAchievement, Mode=TwoWay}"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
        >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="0.05*" />
                <DataGridTextColumn Header="Achievement" Binding="{Binding Name}" Width="0.2*" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Description" MaxWidth="300" Binding="{Binding Description}" Width="0.25*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Secret" Binding="{Binding IsSecret}"  Width="0.1*"/>
                <DataGridTextColumn Header="Date Unlocked" Binding="{Binding DateUnlocked}" Width="0.27*"/>
                <DataGridTextColumn Header="G's" Binding="{Binding Gamerscore}" Width="0.06*"/>
                <DataGridTextColumn Header="Percentage" Binding="{Binding RarityPercentage}" Width="0.13*"/>
                <DataGridTextColumn Header="Rarity" Binding="{Binding RarityCategory}" Width="0.11*"/>
                <DataGridTextColumn Header="State" Binding="{Binding ProgressState}" Width="0.12*"/>
                <DataGridTextColumn Header="Event mapping (debug)" Binding="{Binding EventMappingStatus}" Width="0.25*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="ToolTip" Value="{Binding EventMappingStatus}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Unlock" Width="0.13*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Margin="5,5,5,5" Click="UnlockButton" Tag="{Binding Index, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    IsEnabled="{Binding IsUnlockable}">Unlock</Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Expander
            Grid.Row="2"
            Margin="0,0,0,5"
            Header="Selected achievement requirement details"
            IsExpanded="True">
            <Grid Margin="0,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,5" FontWeight="SemiBold" Text="Achievement API ID"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,15,5"
                           Text="{Binding ViewModel.SelectedAchievement.ID, Mode=OneWay}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,6,5" FontWeight="SemiBold" Text="State"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,0,5" Text="{Binding ViewModel.SelectedAchievement.ProgressState, Mode=OneWay}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,5" FontWeight="SemiBold" Text="Achievement name"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,5"
                           Text="{Binding ViewModel.SelectedAchievement.Name, Mode=OneWay}"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,6,5" FontWeight="SemiBold" Text="Mapping"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,5"
                           Text="{Binding ViewModel.SelectedAchievement.EventMappingStatus, Mode=OneWay}"
                           TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,6,5" FontWeight="SemiBold" Text="Title event support data"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,15,5"
                           Text="{Binding ViewModel.SelectedAchievementEventSupport, Mode=OneWay}"/>
                <ui:Button
                    Grid.Row="3"
                    Grid.Column="3"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Right"
                    Content="Copy details"
                    Icon="{ui:SymbolIcon Copy24}"
                    Command="{Binding ViewModel.CopySelectedAchievementDetailsCommand}"/>

                <DataGrid
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    MaxHeight="140"
                    Margin="0,0,0,5"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ViewModel.SelectedAchievementMappings}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ReplacementType" Binding="{Binding ReplacementType}" Width="*"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
                        <DataGridTextColumn Header="Replacement" Binding="{Binding Replacement}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    MaxHeight="180"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ViewModel.SelectedAchievementRequirements}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Requirement ID" Binding="{Binding id}" Width="2*"/>
                        <DataGridTextColumn Header="Current" Binding="{Binding current}" Width="*"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding target}" Width="*"/>
                        <DataGridTextColumn Header="Operation" Binding="{Binding operationType}" Width="*"/>
                        <DataGridTextColumn Header="Value type" Binding="{Binding valueType}" Width="*"/>
                        <DataGridTextColumn Header="Rule participation" Binding="{Binding ruleParticipationType}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Expander
                    Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="0,8,0,0"
                    Header="Raw achievement requirement source (read-only debug)"
                    IsExpanded="False">
                    <Grid Margin="0,5,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,5" FontWeight="SemiBold" Text="Source endpoint"/>
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,0,5"
                            IsReadOnly="True"
                            Text="{Binding ViewModel.SelectedAchievementSourceEndpoint}"
                            TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,5" FontWeight="SemiBold" Text="requirement.current JSON path"/>
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,0,5"
                            IsReadOnly="True"
                            Text="{Binding ViewModel.SelectedAchievementRequirementJsonPath}"
                            TextWrapping="Wrap"/>

                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Text="{Binding ViewModel.SelectedAchievementRawJson}"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto"/>
                            <TextBox
                                Grid.Column="1"
                                Margin="4,0,0,0"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Text="{Binding ViewModel.SelectedAchievementRawRequirementJson}"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Expander>

                <Expander
                    Grid.Row="7"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="0,8,0,0"
                    Header="Achievement / stat correlation (read-only debug)"
                    IsExpanded="False">
                    <Grid Margin="0,5,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                ClearButtonEnabled="False"
                                PlaceholderText="Candidate stat names, separated by commas"
                                Text="{Binding ViewModel.AchievementStatNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ui:Button
                                Grid.Column="1"
                                Content="Query / Refresh"
                                Icon="{ui:SymbolIcon ArrowSync24}"
                                Command="{Binding ViewModel.QueryAchievementStatCorrelationCommand}"/>
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,8,0,8"
                            Text="{Binding ViewModel.AchievementStatCorrelationStatus}"
                            TextWrapping="Wrap"/>

                        <DataGrid
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding ViewModel.AchievementStatCorrelations}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Match}" Value="Exact">
                                            <Setter Property="Background" Value="#49388E3C"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Match}" Value="Near">
                                            <Setter Property="Background" Value="#49C49A00"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stat name" Binding="{Binding StatName}" Width="2*"/>
                                <DataGridTextColumn Header="Before" Binding="{Binding PreviousStatValue}" Width="*"/>
                                <DataGridTextColumn Header="Stat value" Binding="{Binding StatValue}" Width="*"/>
                                <DataGridTextColumn Header="Stat delta" Binding="{Binding StatDelta}" Width="*"/>
                                <DataGridTextColumn Header="Requirement ID" Binding="{Binding RequirementId}" Width="2*"/>
                                <DataGridTextColumn Header="Req. before" Binding="{Binding PreviousRequirementCurrent}" Width="*"/>
                                <DataGridTextColumn Header="Req. current" Binding="{Binding RequirementCurrent}" Width="*"/>
                                <DataGridTextColumn Header="Req. delta" Binding="{Binding RequirementDelta}" Width="*"/>
                                <DataGridTextColumn Header="Target" Binding="{Binding RequirementTarget}" Width="*"/>
                                <DataGridTextColumn Header="Difference" Binding="{Binding Difference}" Width="*"/>
                                <DataGridTextColumn Header="Match" Binding="{Binding Match}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                <DataGridTextColumn Header="SCID" Binding="{Binding Scid}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Expander>
            </Grid>
        </Expander>
        <Expander
            Grid.Row="3"
            Margin="0,0,0,5"
            Header="Legacy Quantum Break test and telemetry (use Mapping Research Lab)"
            IsExpanded="False"
            Visibility="{Binding ViewModel.IsQuantumBreakTestAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="0,5,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,5" FontWeight="SemiBold" Text="Selected achievement"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" TextWrapping="Wrap">
                    <Run Text="{Binding ViewModel.SelectedAchievement.ID, Mode=OneWay}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding ViewModel.SelectedAchievement.Name, Mode=OneWay}"/>
                    <Run Text=" | "/>
                    <Run Text="{Binding ViewModel.SelectedAchievement.EventMappingStatus, Mode=OneWay}"/>
                </TextBlock>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5" Orientation="Horizontal">
                    <ui:TextBox
                        Width="190"
                        Margin="0,0,8,0"
                        ClearButtonEnabled="False"
                        PlaceholderText="ProgressionData integer"
                        Text="{Binding ViewModel.QuantumBreakProgressionData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <ui:Button Margin="0,0,8,0" Content="Preview" Icon="{ui:SymbolIcon Eye24}"
                               Command="{Binding ViewModel.PreviewQuantumBreakTestEventCommand}"/>
                    <ui:Button Margin="0,0,8,0" Content="Send one test event" Icon="{ui:SymbolIcon Send24}"
                               Command="{Binding ViewModel.SendQuantumBreakTestEventCommand}"/>
                    <ui:Button Margin="0,0,8,0" Content="Refresh snapshot" Icon="{ui:SymbolIcon ArrowSync24}"
                               Command="{Binding ViewModel.RefreshQuantumBreakSnapshotCommand}"/>
                    <ui:Button Content="Copy result" Icon="{ui:SymbolIcon Copy24}"
                               Command="{Binding ViewModel.CopyQuantumBreakTestResultCommand}"/>
                </StackPanel>

                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Height="150"
                        Margin="0,0,4,0"
                        AcceptsReturn="True"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        Text="{Binding ViewModel.QuantumBreakPayloadPreview, Mode=OneWay}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"/>
                    <TextBox
                        Grid.Column="1"
                        Height="150"
                        Margin="4,0,0,0"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        Text="{Binding ViewModel.QuantumBreakTestResult, Mode=OneWay}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <TextBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    MaxHeight="140"
                    AcceptsReturn="True"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    Text="{Binding ViewModel.QuantumBreakProposedMapping, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto"/>

                <Expander
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Header="Quantum Break telemetry capture (read-only)"
                    IsExpanded="False">
                    <Grid Margin="0,5,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="150"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap">
                            <Run Text="Start capture, perform the action in Quantum Break, then exit to menu or close the game before capture ends."/>
                        </TextBlock>

                        <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Duration"/>
                            <ComboBox
                                Width="80"
                                Margin="0,0,6,0"
                                ItemsSource="{Binding ViewModel.QuantumBreakTelemetryCaptureDurations}"
                                SelectedItem="{Binding ViewModel.QuantumBreakTelemetryCaptureSeconds, Mode=TwoWay}"/>
                            <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="seconds"/>
                            <ui:Button
                                Margin="0,0,8,0"
                                Content="Start capture"
                                Icon="{ui:SymbolIcon Record24}"
                                Command="{Binding ViewModel.StartQuantumBreakTelemetryCaptureCommand}"/>
                            <ui:Button
                                Content="Copy sanitized payloads"
                                Icon="{ui:SymbolIcon Copy24}"
                                Command="{Binding ViewModel.CopyQuantumBreakTelemetryCommand}"/>
                        </StackPanel>

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,0,0,8"
                            Text="{Binding ViewModel.QuantumBreakTelemetryCaptureStatus}"
                            TextWrapping="Wrap"/>

                        <DataGrid
                            Grid.Row="3"
                            Margin="0,0,0,8"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding ViewModel.QuantumBreakTelemetryEvents}"
                            SelectedItem="{Binding ViewModel.SelectedQuantumBreakTelemetryEvent, Mode=TwoWay}"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Event name" Binding="{Binding EventName}" Width="2*"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding EventTime}" Width="*"/>
                                <DataGridTextColumn Header="ProgressionData" Binding="{Binding ProgressionData}" Width="*"/>
                                <DataGridTextColumn Header="Properties" Binding="{Binding Properties}" Width="2*"/>
                                <DataGridTextColumn Header="Measurements" Binding="{Binding Measurements}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBox
                            Grid.Row="4"
                            AcceptsReturn="True"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            Text="{Binding ViewModel.SelectedQuantumBreakTelemetryEvent.SanitizedPayload, Mode=OneWay}"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Expander>
            </Grid>
        </Expander>
    </Grid>
</Page>
